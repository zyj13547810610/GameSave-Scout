{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gameshelf.local/schemas/engines.schema.json",
  "title": "GameShelf declarative engine rules",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "rules"],
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "rules": {
      "type": "array",
      "items": {"$ref": "#/$defs/rule"}
    }
  },
  "$defs": {
    "httpsReference": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "path", "weight"],
      "properties": {
        "op": {
          "enum": [
            "path_exists",
            "glob_exists",
            "glob_magic_at",
            "magic_at",
            "magic_from_end",
            "edge_contains",
            "text_contains",
            "pe_field_contains"
          ]
        },
        "path": {"type": "string", "minLength": 1},
        "value": {"type": "string"},
        "offset": {"type": "integer", "minimum": 0, "maximum": 65536},
        "weight": {"type": "number"},
        "field": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "enum": [
                  "glob_magic_at",
                  "magic_at",
                  "magic_from_end",
                  "edge_contains",
                  "text_contains",
                  "pe_field_contains"
                ]
              }
            },
            "required": ["op"]
          },
          "then": {"required": ["value"]}
        },
        {
          "if": {
            "properties": {"op": {"const": "magic_from_end"}},
            "required": ["op"]
          },
          "then": {
            "properties": {
              "offset": {"type": "integer", "minimum": 1, "maximum": 65536}
            },
            "required": ["offset"]
          }
        }
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]{1,80}$"},
        "label": {"type": "string", "minLength": 1},
        "variant": {"type": ["string", "null"]},
        "status": {"enum": ["formal", "experimental"]},
        "priority": {"type": "integer", "minimum": -1000, "maximum": 1000},
        "enabled": {"type": "boolean"},
        "references": {
          "type": "array",
          "items": {"$ref": "#/$defs/httpsReference"},
          "uniqueItems": true
        },
        "threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "all": {
          "type": "array",
          "maxItems": 64,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "any": {
          "type": "array",
          "maxItems": 64,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "negative": {
          "type": "array",
          "maxItems": 64,
          "items": {"$ref": "#/$defs/evidence"}
        }
      }
    }
  }
}
